# AI Interviewer Backend Configuration
PORT=8000
FRONTEND_URL=http://localhost:5173

# AI Order: First Groq, then fallback to Gemini
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-120b
AI_FALLBACK_PROVIDER=gemini
AI_FALLBACK_MODEL=gemini-4-hydrogen
AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2

# 1. Google Gemini API Key (First Priority)
GEMINI_API_KEY=
GOOGLE_API_KEY=

# 2. Fallback AI Provider Keys (Used automatically if Gemini hits limits)
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Storage (Optional - falls back to local data/reports.json and in-memory session if empty)
MONGO_URI=
DB_NAME=ai_interview_db
REDIS_HOST=
REDIS_PORT=
INTERVIEW_SESSION_TTL_SECONDS=21600
